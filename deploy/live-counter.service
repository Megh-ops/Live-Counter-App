[Unit]
Description=Live Counter Express & React Application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/live-counter-app/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=PORT=5000
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

